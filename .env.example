# Copie este archivo como .env y complete los valores. NUNCA suba .env a GitHub ni lo muestre en el video.
# --- Entrenamiento (recurso AnimalIdentificationJGR) ---
CV_TRAINING_ENDPOINT=https://eastus.api.cognitive.microsoft.com/
CV_TRAINING_KEY=
CV_PROJECT_ID=
# az cognitiveservices account show -n AnimalIdentificationJGR-Prediction -g ComputerVisionImages --query id -o tsv
CV_PREDICTION_RESOURCE_ID=
# --- Predicción (recurso AnimalIdentificationJGR-Prediction) ---
CV_PREDICTION_ENDPOINT=https://eastus.api.cognitive.microsoft.com/
CV_PREDICTION_KEY=
CV_PUBLISH_NAME=iter3-advanced
# Transacciones por segundo del recurso de predicción (F0 = 2, S0 = 10)
CV_TPS=1.8
# CV_MOCK=1 simula el endpoint (solo para probar la app sin Azure)
CV_MOCK=0
